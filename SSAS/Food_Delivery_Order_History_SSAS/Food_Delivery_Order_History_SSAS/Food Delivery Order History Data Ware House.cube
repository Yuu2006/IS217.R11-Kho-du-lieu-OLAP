  <Source dwd:design-time-name="d0f3000e-3a8b-4f01-8328-5f609a7907f2">
    <DataSourceViewID>Food Delivery Order History Data Ware House</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="5c1ed6db-512e-4abf-af01-ea958f6398f2">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;  

CREATE MEMBER CURRENTCUBE.[Measures].[AverageItemsPerOrder]
 AS IIF([Measures].[OrderCount] = 0, NULL,
        1 * [Measures].[ItemQuantity] / [Measures].[OrderCount]),
 FORMAT_STRING = '0.00', VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[AverageOrderAmount]
 AS IIF([Measures].[OrderCount] = 0, NULL,
        1 * [Measures].[TotalAmount] / [Measures].[OrderCount]),
 FORMAT_STRING = '#,##0.00', VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[DiscountPercent]
 AS IIF([Measures].[SubtotalAmount] = 0, NULL,
        100.0 * [Measures].[DiscountAmount] / [Measures].[SubtotalAmount]),
 FORMAT_STRING = '0.00', VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[AverageRating]
 AS IIF([Measures].[RatingCount] = 0, NULL,
        1 * [Measures].[RatingSum] / [Measures].[RatingCount]),
 FORMAT_STRING = '0.00', VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[AverageKptMinutes]
 AS IIF([Measures].[KptCount] = 0, NULL,
        1 * [Measures].[KptSum] / [Measures].[KptCount]),
 FORMAT_STRING = '0.00', VISIBLE = 1;  

CREATE MEMBER CURRENTCUBE.[Measures].[AverageRiderWaitMinutes]
 AS IIF([Measures].[RiderWaitCount] = 0, NULL,
        1 * [Measures].[RiderWaitSum] / [Measures].[RiderWaitCount]),
 FORMAT_STRING = '0.00', VISIBLE = 1;  

CREATE DYNAMIC SET CURRENTCUBE.[NS03_Top10Items] AS
 TOPCOUNT(NONEMPTY([DIM ITEM].[Item].[Item].Members, [Measures].[ItemQuantity]), 10, [Measures].[ItemQuantity]);

CREATE DYNAMIC SET CURRENTCUBE.[NS04_TopRestaurant] AS
 TOPCOUNT(NONEMPTY([DIM RESTAURANT].[RestaurantName].[RestaurantName].Members, [Measures].[TotalAmount]), 1, [Measures].[TotalAmount]);

CREATE DYNAMIC SET CURRENTCUBE.[NS06_Statuses] AS
 {[DIM OUTCOME].[OrderStatus].&amp;[Delivered], [DIM OUTCOME].[OrderStatus].&amp;[Rejected]};

CREATE DYNAMIC SET CURRENTCUBE.[NS08_Top3Packaging] AS
 TOPCOUNT(NONEMPTY([DIM RESTAURANT].[RestaurantName].[RestaurantName].Members, [Measures].[PackagingAmount]), 3, [Measures].[PackagingAmount]);

CREATE DYNAMIC SET CURRENTCUBE.[NS09_RatedRestaurants] AS
 FILTER([DIM RESTAURANT].[RestaurantName].[RestaurantName].Members, [Measures].[RatingCount] &gt; 0);

CREATE DYNAMIC SET CURRENTCUBE.[NS10_Complaints] AS
 FILTER([DIM OUTCOME].[ComplaintTag].[ComplaintTag].Members,
        [DIM OUTCOME].[ComplaintTag].CurrentMember.Name &lt;&gt; "Not recorded");

CREATE DYNAMIC SET CURRENTCUBE.[NS13_Top3ReturningCustomers] AS
 TOPCOUNT(FILTER([DIM CUSTOMER].[Customer].[Customer].Members, [Measures].[OrderCount] &gt;= 2), 3, [Measures].[TotalAmount]);

CREATE DYNAMIC SET CURRENTCUBE.[NS14_PeakDayParts] AS
 FILTER(NONEMPTY([DIM TIME].[DayPart].[DayPart].Members, [Measures].[OrderCount]), [Measures].[OrderCount] = MAX([DIM TIME].[DayPart].[DayPart].Members, [Measures].[OrderCount]));

CREATE DYNAMIC SET CURRENTCUBE.[NS15_WeekendTop10Items] AS
 TOPCOUNT(NONEMPTY([DIM ITEM].[Item].[Item].Members, ([Measures].[ItemQuantity], [DIM DATE].[IsWeekend].&amp;[1])), 10, ([Measures].[ItemQuantity], [DIM DATE].[IsWeekend].&amp;[1]));

// Q14: tap co ngu canh ngay tuong minh, giu tat ca buoi dong hang.
CREATE DYNAMIC SET CURRENTCUBE.[NS14_WeekdayPeakDayParts] AS
 FILTER(
   NONEMPTY([DIM TIME].[DayPart].[DayPart].Members,
     ([Measures].[OrderCount], [DIM DATE].[IsWeekend].&amp;[0])),
   ([Measures].[OrderCount], [DIM DATE].[IsWeekend].&amp;[0]) =
   MAX([DIM TIME].[DayPart].[DayPart].Members,
     ([Measures].[OrderCount], [DIM DATE].[IsWeekend].&amp;[0]))
 );

// Q14: tap co ngu canh ngay tuong minh, giu tat ca buoi dong hang.
CREATE DYNAMIC SET CURRENTCUBE.[NS14_WeekendPeakDayParts] AS
 FILTER(
   NONEMPTY([DIM TIME].[DayPart].[DayPart].Members,
     ([Measures].[OrderCount], [DIM DATE].[IsWeekend].&amp;[1])),
   ([Measures].[OrderCount], [DIM DATE].[IsWeekend].&amp;[1]) =
   MAX([DIM TIME].[DayPart].[DayPart].Members,
     ([Measures].[OrderCount], [DIM DATE].[IsWeekend].&amp;[1]))
 ); </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>