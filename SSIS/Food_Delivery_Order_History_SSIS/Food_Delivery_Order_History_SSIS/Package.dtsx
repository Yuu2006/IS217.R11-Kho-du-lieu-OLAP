    <DTS:Executable
      DTS:refId="Package\Create All Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DE5A5004-0983-420C-8194-F1BF575DDE7C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create All Tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0928A9E7-D201-4092-A5BD-3F075FE911D5}"
          SQLTask:SqlStatementSource="-- Khoi tao bang DIM&#xA;CREATE TABLE DIM_DATE (&#xA;    DATE_ID INT NOT NULL PRIMARY KEY,&#xA;    FULL_DATE DATE NOT NULL UNIQUE,&#xA;    DAY_OF_MONTH TINYINT NOT NULL,&#xA;    MONTH_NUMBER TINYINT NOT NULL,&#xA;    QUARTER_NUMBER TINYINT NOT NULL,&#xA;    YEAR_NUMBER SMALLINT NOT NULL,&#xA;    WEEKDAY_NUMBER TINYINT NOT NULL,&#xA;    IS_WEEKEND BIT NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE DIM_TIME (&#xA;    TIME_ID TINYINT NOT NULL PRIMARY KEY,&#xA;    HOUR_NUMBER TINYINT NOT NULL,&#xA;    DAY_PART NVARCHAR(20) NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE DIM_RESTAURANT (&#xA;    RESTAURANT_ID INT NOT NULL PRIMARY KEY,&#xA;    SOURCE_RESTAURANT_ID INT NOT NULL,&#xA;    RESTAURANT_NAME NVARCHAR(100) NOT NULL,&#xA;    SUBZONE NVARCHAR(100) NOT NULL,&#xA;    CITY NVARCHAR(100) NOT NULL,&#xA;    CONSTRAINT UQ_DIM_RESTAURANT_NK UNIQUE&#xA;        (SOURCE_RESTAURANT_ID, RESTAURANT_NAME, SUBZONE, CITY)&#xA;);&#xA;&#xA;CREATE TABLE DIM_CUSTOMER (&#xA;    CUSTOMER_ID INT NOT NULL PRIMARY KEY,&#xA;    SOURCE_CUSTOMER_ID NVARCHAR(64) NOT NULL UNIQUE&#xA;);&#xA;&#xA;CREATE TABLE DIM_ITEM (&#xA;    ITEM_ID INT NOT NULL PRIMARY KEY,&#xA;    ITEMS_IN_ORDER NVARCHAR(200) NOT NULL UNIQUE&#xA;);&#xA;&#xA;CREATE TABLE DIM_OUTCOME (&#xA;    OUTCOME_ID INT NOT NULL PRIMARY KEY,&#xA;    ORDER_STATUS NVARCHAR(40) NOT NULL,&#xA;    ORDER_READY_MARKED NVARCHAR(40) NOT NULL,&#xA;    CANCELLATION_REJECTION_REASON NVARCHAR(100) NULL,&#xA;    CUSTOMER_COMPLAINT_TAG NVARCHAR(100) NULL,&#xA;    CONSTRAINT UQ_DIM_OUTCOME_NK UNIQUE&#xA;        (ORDER_STATUS, ORDER_READY_MARKED, CANCELLATION_REJECTION_REASON, CUSTOMER_COMPLAINT_TAG)&#xA;);&#xA;&#xA;CREATE TABLE DIM_PROMOTION (&#xA;    PROMOTION_ID INT NOT NULL PRIMARY KEY,&#xA;    DISCOUNT_CONSTRUCT NVARCHAR(100) NULL UNIQUE,&#xA;    PROMOTION_TYPE NVARCHAR(30) NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE DIM_DISTANCE (&#xA;    DISTANCE_ID INT NOT NULL PRIMARY KEY,&#xA;    DISTANCE NVARCHAR(20) NOT NULL UNIQUE,&#xA;    DISTANCE_INT TINYINT NOT NULL&#xA;);&#xA;-- Khoi tao bang FACT&#xA;CREATE TABLE FACT_ORDER (&#xA;    FACT_ORDER_ID BIGINT NOT NULL PRIMARY KEY,&#xA;    SOURCE_ORDER_ID BIGINT NOT NULL UNIQUE,&#xA;    DATE_ID INT NOT NULL REFERENCES DIM_DATE(DATE_ID),&#xA;    TIME_ID TINYINT NOT NULL REFERENCES DIM_TIME(TIME_ID),&#xA;    RESTAURANT_ID INT NOT NULL REFERENCES DIM_RESTAURANT(RESTAURANT_ID),&#xA;    CUSTOMER_ID INT NOT NULL REFERENCES DIM_CUSTOMER(CUSTOMER_ID),&#xA;    OUTCOME_ID INT NOT NULL REFERENCES DIM_OUTCOME(OUTCOME_ID),&#xA;    PROMOTION_ID INT NOT NULL REFERENCES DIM_PROMOTION(PROMOTION_ID),&#xA;    DISTANCE_ID INT NOT NULL REFERENCES DIM_DISTANCE(DISTANCE_ID),&#xA;    BILL_SUBTOTAL DECIMAL(14,2) NOT NULL,&#xA;    PACKAGING_CHARGES DECIMAL(14,2) NOT NULL,&#xA;    DISCOUNT_TOTAL DECIMAL(14,2) NOT NULL,&#xA;    TOTAL DECIMAL(14,2) NOT NULL,&#xA;    RATING_VALUE DECIMAL(3,1) NULL,&#xA;    KPT_MINUTES DECIMAL(8,2) NULL,&#xA;    RIDER_WAIT_MINUTES DECIMAL(8,2) NULL&#xA;);&#xA;-- Khoi tao bang BRIDGE&#xA;CREATE TABLE BRIDGE_ORDER_ITEM (&#xA;    FACT_ORDER_ID BIGINT NOT NULL REFERENCES FACT_ORDER(FACT_ORDER_ID),&#xA;    ITEM_ID INT NOT NULL REFERENCES DIM_ITEM(ITEM_ID),&#xA;    ITEM_QUANTITY INT NOT NULL CHECK (ITEM_QUANTITY &gt; 0),&#xA;    CONSTRAINT PK_BRIDGE_ORDER_ITEM PRIMARY KEY (FACT_ORDER_ID, ITEM_ID)&#xA;);&#xA;&#xA;CREATE INDEX IX_FACT_ORDER_DATE ON FACT_ORDER(DATE_ID);&#xA;CREATE INDEX IX_FACT_ORDER_RESTAURANT ON FACT_ORDER(RESTAURANT_ID);&#xA;CREATE INDEX IX_FACT_ORDER_CUSTOMER ON FACT_ORDER(CUSTOMER_ID);&#xA;CREATE INDEX IX_FACT_ORDER_OUTCOME ON FACT_ORDER(OUTCOME_ID);&#xA;CREATE INDEX IX_BRIDGE_ORDER_ITEM_ITEM ON BRIDGE_ORDER_ITEM(ITEM_ID);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
